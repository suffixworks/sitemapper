# Copy to .env.local for local dev (never commit .env.local).
# All server-only except NEXT_PUBLIC_SITE_URL.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL for auth callbacks + share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash (guest comment rate limit — Phase 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
